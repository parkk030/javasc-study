# PatchRadar Serverless Environment Configuration
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="PatchRadar"

# Set USE_MOCK_DB="true" for zero-config local development and deterministic harness tests.
# Set USE_MOCK_DB="false" in production when connected to Supabase PostgreSQL.
USE_MOCK_DB="true"

# Required only when USE_MOCK_DB="false"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
